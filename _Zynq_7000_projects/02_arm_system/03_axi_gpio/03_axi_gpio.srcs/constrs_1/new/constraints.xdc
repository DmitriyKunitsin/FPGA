# Кнопка
set_property IOSTANDARD LVCMOS33 [get_ports {button[0]}]
set_property PACKAGE_PIN M19 [get_ports {button[0]}]
# Светодиоды
set_property PACKAGE_PIN T12 [get_ports {leds[3]}]
set_property PACKAGE_PIN U12 [get_ports {leds[2]}]
set_property PACKAGE_PIN V12 [get_ports {leds[1]}]
set_property PACKAGE_PIN W13 [get_ports {leds[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {leds[3] leds[2] leds[1] leds[0]}]


